				{
					"name": "POST create comment",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"(async function() {\r",
									"const api = new API(pm, true);\r",
									"const rnd = new RandomUtils();\r",
									"\r",
									"const owner = await api.addUser(rnd.getUser());\r",
									"const commenter = await api.addUser(rnd.getUser());\r",
									"const category = await api.addCategory(rnd.getCategory());\r",
									"let event = await api.addEvent(owner.id, rnd.getEvent(category.id));\r",
									"\r",
									"event = await api.publishEvent(event.id);\r",
									"\r",
									"pm.environment.set(\"commenterId\", commenter.id);\r",
									"pm.environment.set(\"eventId\", event.id);\r",
									"})();"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Comment created successfully\", function () {\r",
									"    const response = pm.response.json();\r",
									"    \r",
									"    pm.response.to.have.status(201);\r",
									"    pm.expect(response).to.have.property(\"id\");\r",
									"    pm.expect(response).to.have.property(\"text\");\r",
									"    pm.expect(response).to.have.property(\"eventId\");\r",
									"    pm.expect(response).to.have.property(\"authorId\");\r",
									"    pm.expect(response).to.have.property(\"createdDate\");\r",
									"    \r",
									"    pm.environment.set(\"commentId2\", response.id);\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
