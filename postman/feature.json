	"item": [
		{
			"name": "SETUP",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const owner = {\r",
							"    name: \"Owner_\" + Math.random().toString(36).substring(7),\r",
							"    email: \"owner_\" + Date.now() + \"@test.com\"\r",
							"};\r",
							"\r",
							"pm.sendRequest({\r",
							"    url: 'http://localhost:8080/admin/users',\r",
							"    method: 'POST',\r",
							"    header: {'Content-Type': 'application/json'},\r",
							"    body: {mode: 'raw', raw: JSON.stringify(owner)}\r",
							"}, function (err, ownerRes) {\r",
							"    if (err) {\r",
							"        console.error('Error creating owner:', err);\r",
							"        return;\r",
							"    }\r",
							"    const ownerId = ownerRes.json().id;\r",
							"    pm.environment.set(\"ownerId\", ownerId);\r",
							"    \r",
							"    const commenter = {\r",
							"        name: \"Commenter_\" + Math.random().toString(36).substring(7),\r",
							"        email: \"commenter_\" + Date.now() + \"@test.com\"\r",
							"    };\r",
							"    \r",
							"    pm.sendRequest({\r",
							"        url: 'http://localhost:8080/admin/users',\r",
							"        method: 'POST',\r",
							"        header: {'Content-Type': 'application/json'},\r",
							"        body: {mode: 'raw', raw: JSON.stringify(commenter)}\r",
							"    }, function (err, commenterRes) {\r",
							"        if (err) {\r",
							"            console.error('Error creating commenter:', err);\r",
							"            return;\r",
							"        }\r",
							"        const commenterId = commenterRes.json().id;\r",
							"        pm.environment.set(\"commenterId\", commenterId);\r",
							"        \r",
							"        pm.sendRequest({\r",
							"            url: 'http://localhost:8080/admin/categories',\r",
							"            method: 'POST',\r",
							"            header: {'Content-Type': 'application/json'},\r",
							"            body: {mode: 'raw', raw: JSON.stringify({ name: \"Category_\" + Date.now() })}\r",
							"        }, function (err, catRes) {\r",
							"            if (err) {\r",
							"                console.error('Error creating category:', err);\r",
							"                return;\r",
							"            }\r",
							"            const categoryId = catRes.json().id;\r",
							"            pm.environment.set(\"categoryId\", categoryId);\r",
							"            \r",
							"            const event = {\r",
							"                annotation: \"Test annotation for comments that is long enough 20 symbols...\",\r",
							"                category: categoryId,\r",
							"                description: \"Test description that is definitely more than twenty symbols long for validation\",\r",
							"                eventDate: \"2026-12-31 15:00:00\",\r",
							"                location: { lat: 55.7558, lon: 37.6173 },\r",
							"                paid: false,\r",
							"                participantLimit: 10,\r",
							"                requestModeration: true,\r",
							"                title: \"Event for Comments Test\"\r",
							"            };\r",
							"            \r",
							"            \r",
							"            pm.sendRequest({\r",
							"                url: 'http://localhost:8080/users/' + ownerId + '/events',\r",
							"                method: 'POST',\r",
							"                header: {'Content-Type': 'application/json'},\r",
							"                body: {mode: 'raw', raw: JSON.stringify(event)}\r",
							"            }, function (err, eventRes) {\r",
							"                if (err) {\r",
							"                    console.error('Error creating event:', err);\r",
							"                    console.error('Response:', eventRes);\r",
							"                    return;\r",
							"                }\r",
							"                \r",
							"                const eventId = eventRes.json().id;\r",
							"                pm.environment.set(\"eventId\", eventId);\r",
							"                \r",
							"                pm.sendRequest({\r",
							"                    url: 'http://localhost:8080/admin/events/' + eventId,\r",
							"                    method: 'PATCH',\r",
							"                    header: {'Content-Type': 'application/json'},\r",
							"                    body: {\r",
							"                        mode: 'raw', \r",
							"                        raw: JSON.stringify({ stateAction: \"PUBLISH_EVENT\" })\r",
							"                    }\r",
							"                }, function (err, publishRes) {\r",
							"                    if (err) {\r",
							"                        console.error('Error publishing event:', err);\r",
							"                    } else {\r",
							"                        console.log('Event published successfully');\r",
							"                    }\r",
							"                });\r",
							"            });\r",
							"        });\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/events",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"events"
					]
				}
			},
			"response": []
