			"item": [
				{
					"name": "POST create comment",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"(async function() {\r",
									"    try {\r",
									"        const ownerId = await createUser('Owner');\r",
									"        const commenterId = await createUser('Commenter');\r",
									"        pm.environment.set('commenterId', commenterId);\r",
									"        const categoryId = await createCategory();\r",
									"        const eventId = await createEvent(ownerId, categoryId);\r",
									"        pm.environment.set('eventId', eventId);\r",
									"        await publishEvent(eventId);\r",
									"        \r",
									"        console.log('Данные для теста созданы:', {commenterId, eventId});\r",
									"    } catch (err) {\r",
									"        console.error('❌ Ошибка создания данных:', err);\r",
									"    }\r",
									"})();"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Comment created successfully\", function () {\r",
									"    const response = pm.response.json();\r",
									"    \r",
									"    pm.response.to.have.status(201);\r",
									"    pm.expect(response).to.have.property(\"id\");\r",
									"    pm.expect(response).to.have.property(\"text\");\r",
									"    pm.expect(response).to.have.property(\"eventId\");\r",
									"    pm.expect(response).to.have.property(\"authorId\");\r",
									"    pm.expect(response).to.have.property(\"createdDate\");\r",
									"    \r",
									"    pm.environment.set(\"commentId2\", response.id);\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
